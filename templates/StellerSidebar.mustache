{{!
	string msg-steller-sidebar-label Visible label for the navigation toggle.
	string msg-steller-sidebar-open Accessible label when navigation is closed.
}}

<div class="steller-sidebar citizen-header__item citizen-dropdown">
	<details
		id="steller-sidebar-details"
		class="citizen-dropdown-details steller-sidebar__details"
	>
		<summary
			class="steller-sidebar__toggle citizen-dropdown-summary citizen-cdx-button--size-large cdx-button cdx-button--fake-button cdx-button--fake-button--enabled cdx-button--weight-quiet"
			title="{{msg-steller-sidebar-open}}"
			aria-label="{{msg-steller-sidebar-open}}"
			aria-controls="steller-sidebar-card"
		>
			<span
				class="steller-sidebar__toggle-icon steller-sidebar__toggle-icon--desktop citizen-ui-icon mw-ui-icon-wikimedia-tableMoveColumnBefore"
				aria-hidden="true"
			></span>

			<span
				class="steller-sidebar__toggle-icon steller-sidebar__toggle-icon--mobile"
				aria-hidden="true"
			>
				{{>Icon__menu}}
			</span>

			<span class="steller-sidebar__toggle-label">
				{{msg-steller-sidebar-label}}
			</span>
		</summary>
	</details>

	<div
		id="steller-sidebar-card"
		class="steller-sidebar__card citizen-drawer__card citizen-menu__card"
	>
		<div class="citizen-menu__card-content steller-sidebar__card-content">
			<div class="citizen-drawer__header steller-sidebar__mobile-header">
				{{>Drawer__logo}}

				<div class="citizen-drawer__siteinfo">
					{{>Wordmark}}
				</div>
			</div>

			{{#data-main-menu}}
				{{>StellerMainMenu}}
			{{/data-main-menu}}
		</div>
	</div>
</div>