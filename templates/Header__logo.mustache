<div class="citizen-header__logo steller-header__logo">
	<a
		href="{{link-mainpage}}"
		class="mw-logo steller-header__logo-link"
		title="{{msg-tooltip-p-logo}}"
	>
		<img
			class="mw-logo-icon steller-logo-icon"
			src="{{>Logo_icon_src}}"
			alt=""
			aria-hidden="true"
			width="32"
			height="32"
		>

		{{#data-logos.1x}}
			<img
				class="steller-logo-full"
				src="{{.}}"
				alt=""
				aria-hidden="true"
			>
		{{/data-logos.1x}}

		{{^data-logos.1x}}
			<img
				class="steller-logo-full"
				src="{{>Logo_icon_src}}"
				alt=""
				aria-hidden="true"
			>
		{{/data-logos.1x}}
	</a>
</div>